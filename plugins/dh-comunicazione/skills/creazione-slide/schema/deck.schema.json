{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DH Unica deck",
  "type": "object",
  "required": ["title", "slides"],
  "properties": {
    "title": { "type": "string" },
    "output": { "enum": ["html", "marp"], "default": "html" },
    "theme": {
      "type": "object",
      "description": "Override opzionali della palette brand.",
      "properties": {
        "navy": { "type": "string" },
        "blue": { "type": "string" },
        "blue_mid": { "type": "string" },
        "cyan": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layout"],
        "properties": {
          "layout": {
            "enum": ["cover", "section-divider", "lead-bullets", "cards",
                     "tech-list", "table", "stats-row", "image-showcase", "closing"]
          },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "lead": { "type": "string" },
          "description": { "type": "string" },
          "image": { "type": "string", "description": "Percorso relativo all'HTML di output." },
          "image_box": { "type": "boolean", "description": "Forza il box immagine senza sorgente (placeholder)." },
          "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
          "contacts": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "properties": { "name": {"type":"string"}, "role": {"type":"string"} } }
              ]
            }
          },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kicker": { "type": "string", "description": "Etichetta in alto (categoria o numero step)." },
                "icon": { "type": "string", "description": "Emoji o sigla nel cerchio icona." },
                "heading": { "type": "string" },
                "body": { "type": "string" },
                "color": { "type": "string", "description": "Override colore accento (default: rotazione palette)." }
              }
            }
          },
          "items": {
            "type": "array",
            "description": "Per layout tech-list.",
            "items": {
              "type": "object",
              "properties": {
                "badge": { "type": "string" },
                "name": { "type": "string" },
                "body": { "type": "string" }
              }
            }
          },
          "headers": { "type": "array", "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "array" } },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": { "type": "string" },
                "label": { "type": "string" },
                "hint": { "type": "string" }
              }
            }
          },
          "credits": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "properties": { "site": {"type":"string"}, "text": {"type":"string"} } }
              ]
            }
          }
        }
      }
    }
  }
}
